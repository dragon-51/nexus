    public abstract class Personaje
    {
        public string Nombre { get; protected set; }
        public int Salud { get; set; }
        public int SaludMaxima { get; protected set; }

        public Personaje(string nombre, int salud)
        {
            Nombre = nombre;
            Salud = salud;
            SaludMaxima = salud;
        }

        // Ataques del enemigo inspirados en el sistema de Pokémon
        public abstract int EjecutarAtaqueEnemigo();
    }

    public class Cadete : Personaje
    {
        public int Edad { get; private set; }
        public int Energia { get; set; }
        public int Estabilidad { get; set; }
        public int Experiencia { get; set; }
        public List<string> Inventario { get; private set; }

        public int PosX { get; set; } = 1;
        public int PosY { get; set; } = 1;

        public Cadete(string nombre, int edad, int energia, int estabilidad) : base(nombre, 100)
        {
            Edad = Math.Clamp(edad, 16, 100);
            Energia = Math.Clamp(energia, 0, 100);
            Estabilidad = Math.Clamp(estabilidad, 0, 100);
            Experiencia = 0;
            Inventario = new List<string> { "Célula de energía", "Escudo" };
        }

        public override int EjecutarAtaqueEnemigo() => 0; 

        public void MostrarInventario()
        {
            Console.WriteLine("\n--- INVENTARIO DE SUPERVIVENCIA ---");
            if (Inventario.Count == 0)
            {
                Console.WriteLine(" El inventario está completamente vacío.");
                return;
            }
            for (int i = 0; i < Inventario.Count; i++)
            {
                Console.WriteLine($" {i + 1}. {Inventario[i]}");
            }
        }
    }

