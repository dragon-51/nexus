        private void SimularCarga(string mensaje)
        {
            Console.ForegroundColor = ConsoleColor.Yellow;
            Console.WriteLine($"\n {mensaje.ToUpper()}...");
            int totalBloques = 15;
            for (int i = 0; i <= totalBloques; i++)
            {
                Console.Write("\r Loading: [");
                Console.ForegroundColor = ConsoleColor.Green;
                Console.Write(new string('█', i) + new string('░', totalBloques - i));
                Console.ForegroundColor = ConsoleColor.Yellow;
                Console.Write($"] {(i * 100) / totalBloques}%");
                Thread.Sleep(40);
            }
            Console.ResetColor();
            Console.WriteLine();
        }
        private void DibujarBarra(string nombre, int porcentaje, ConsoleColor color)
        {
            Console.ForegroundColor = color;
            int totalBloques = 25;
            int bloquesCompletados = Math.Clamp((porcentaje * totalBloques) / 100, 0, totalBloques);
            string barra = new string('█', bloquesCompletados) + new string('░', totalBloques - bloquesCompletados);
            Console.WriteLine($"{nombre}: [{barra}] {Math.Clamp(porcentaje, 0, 100)}%");
            Console.ResetColor();
        }
        private static void MostrarAlertaIris(string mensaje, double entropia)
        {
            Console.Clear();
            Console.ForegroundColor = ConsoleColor.Red;
            Console.WriteLine("========================================");
            Console.WriteLine(" ALERTA DE INTERFERENCIA CRÍTICA IRIS ");
            Console.WriteLine("========================================");
            Console.WriteLine($"MOTIVO: {mensaje}");
            Console.WriteLine($"NIVEL DE ENTROPÍA: {entropia} / Límite: 5600");
            Console.WriteLine("========================================");
            Console.ResetColor();
        }
        private string LeerCadenaObligatoria(string mensaje)
        {
            while (true)
            {
                Console.Write(mensaje);
                string entrada = Console.ReadLine()?.Trim();
                if (!string.IsNullOrEmpty(entrada)) return entrada;
                Console.WriteLine(" [ERROR]: Entrada vacía no permitida.");
            }
        }
        private int LeerEnteroEnRango(string mensaje, int min, int max)
        {
            while (true)
            {
                Console.Write(mensaje);
                if (int.TryParse(Console.ReadLine(), out int valor))
                {
                    if (valor >= min && valor <= max) return valor;
                    Console.WriteLine($" [VALOR FUERA DE RANGO]: Elija un valor entre {min} y {max}.");
                }
                else { Console.WriteLine(" [ERROR DE FORMATO]: Ingrese un valor numérico entero."); }
            }
        }
