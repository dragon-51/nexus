        private void ProcesarAccionMenu(int opcion)
        {
            switch (opcion)
            {
                case 1:
                    MenuMovimiento();
                    break;
                case 2:
                    MenuInventario();
                    break;
                case 3:
                    SimularCarga("Pingeando servidores centrales de IRIS");
                    Console.WriteLine("\n[DIAGNÓSTICO]: Canales cuánticos operando con normalidad.");
                    break;
                case 4:
                    SimularCarga("Canalizando sobrecarga termo-nuclear");
                    _cadete.Energia += 35;
                    if (_cadete.Energia > 100) _cadete.Energia = 100;
                    Console.WriteLine($"\n[SISTEMA]: Energía reestablecida con éxito.");
                    break;
                case 5:
                    if (_misionCompletada)
                    {
                        SimularCarga("Iniciando secuencia de extracción");
                        Console.ForegroundColor = ConsoleColor.Green;
                        Console.WriteLine("\n MISIÓN COMPLETADA: 'La anomalía perdida'");
                        Console.WriteLine(" +100 XP Adquirida.");
                        Console.WriteLine(" +1 Módulo desconocido añadido a la base de datos central.");
                        _cadete.Experiencia += 100;
                        _sesionActiva = false;
                        Console.ResetColor();
                    }
                    else
                    {
                        Console.ForegroundColor = ConsoleColor.Yellow;
                        Console.WriteLine("\n[ADVERTENCIA]: Extracción abortada. Encuentre el Núcleo 'N' antes de salir.");
                        Console.ResetColor();
                    }
                    break;
            }
        }
        private void MenuMovimiento()
        {
            bool explorando = true;
            while (explorando)
            {
                double entropiaMoviendose = (100 - _cadete.Estabilidad) * (100 - _cadete.Energia);
                if (entropiaMoviendose > 5600 || _cadete.Salud <= 0)
                {
                    break;
                }
                Console.Clear();
                Console.WriteLine($"[SISTEMA VITAL]: SALUD: {_cadete.Salud}% | ENERGÍA: {_cadete.Energia}% | ESTABILIDAD: {_cadete.Estabilidad}%");
                _mapa.Renderizar(_cadete.PosX, _cadete.PosY);
                Console.WriteLine("CONTROLES: Presione [W], [A], [S], [D] para caminar | Presione [Q] para salir al Menú");
                ConsoleKeyInfo teclaInfo = Console.ReadKey(true);
                char dir = char.ToUpper(teclaInfo.KeyChar);
                if (dir == 'Q')
                {
                    explorando = false;
                    Console.WriteLine("\n[SISTEMA]: Regresando al panel de control central...");
                    Thread.Sleep(400);
                    continue;
                }
                int nuevoX = _cadete.PosX;
                int nuevoY = _cadete.PosY;
                if (dir == 'W') nuevoX--;
                else if (dir == 'S') nuevoX++;
                else if (dir == 'A') nuevoY--;
                else if (dir == 'D') nuevoY++;
                else
                {
                    continue;
                }
                if (nuevoX < 0 || nuevoX >= _mapa.ObtenerFilas() || nuevoY < 0 || nuevoY >= _mapa.ObtenerColumnas())
                {
                    Console.ForegroundColor = ConsoleColor.Red;
                    Console.WriteLine("\n[ ALERTA BARRERA]: Error de coordenadas. Bloqueado por cortafuegos.");
                    Console.ResetColor();
                    Thread.Sleep(600);
                    continue;
                }
                if (_mapa.ObtenerCelda(nuevoX, nuevoY) == '█')
                {
                    Console.ForegroundColor = ConsoleColor.Red;
                    Console.WriteLine("\n[ COLISIÓN]: Movimiento cancelado. Obstáculo intransitable detectado.");
                    Console.ResetColor();
                    Thread.Sleep(600);
                    continue;
                }
                _cadete.PosX = nuevoX;
                _cadete.PosY = nuevoY;
                GatillarEventosCasilla(_mapa.ObtenerCelda(nuevoX, nuevoY));
                if (_misionCompletada && _mapa.ObtenerCelda(nuevoX, nuevoY) == '.')
                {
                    Console.WriteLine("\n¡Presione cualquier tecla para continuar moviéndose hacia el punto de extracción!");
                    Console.ReadKey(true);
                }
            }
            Console.Clear();
        }
 
        private void IniciarFaseCombatePokemon(Personaje enemigo)
        {
            Console.Clear();
            Console.ForegroundColor = ConsoleColor.DarkRed;
            Console.WriteLine("=================================================");
            Console.WriteLine($"  ¡UN {enemigo.Nombre.ToUpper()} CORRUPTO APARECIÓ!  ");
            Console.WriteLine("=================================================");
            Console.ResetColor();
            Thread.Sleep(1200);
            bool enCombate = true;
            while (enCombate && _cadete.Salud > 0 && enemigo.Salud > 0)
            {
                Console.Clear();
                Console.WriteLine("-------------------------------------------------");
                Console.ForegroundColor = ConsoleColor.Red;
                Console.WriteLine($"  ENMIGO: {enemigo.Nombre} [{enemigo.Salud}/{enemigo.SaludMaxima} HP]");
                Console.ForegroundColor = ConsoleColor.Green;
                Console.WriteLine($"  CADETE: {_cadete.Nombre} [{_cadete.Salud}/100 HP] | ENERGÍA: {_cadete.Energia}%");
                Console.ResetColor();
                Console.WriteLine("-------------------------------------------------");
                Console.WriteLine(" ¿Qué debería hacer el Cadete?");
                Console.WriteLine(" 1.  ATACAR (Rifle Cuántico)      2.  USAR OBJETO (Inventario)");
                Console.WriteLine(" 3.  ESCAPAR                     ");
                Console.WriteLine("-------------------------------------------------");
                int accion = LeerEnteroEnRango(" Selecciona una opción (1-3): ", 1, 3);
                // --- 1. TURNO DEL JUGADOR ---
                bool turnoEnemigoActivo = true;
                if (accion == 1) // Atacar
                {
                    int dañoJugador = _random.Next(15, 30);
                    Console.ForegroundColor = ConsoleColor.Green;
                    Console.WriteLine($"\n  ¡{_cadete.Nombre} usó RIFLE CUÁNTICO!");
                    Console.WriteLine($" ¡Le infligió {dañoJugador} de daño al objetivo!");
                    Console.ResetColor();
                    enemigo.Salud -= dañoJugador;
                    _cadete.Energia -= 5; 
                }
                else if (accion == 2) 
                {
                    if (_cadete.Inventario.Count == 0)
                    {
                        Console.WriteLine("\n ¡Tu mochila está vacía! Pierdes el turno por abrirla en pleno combate.");
                    }
                    else
                    {
                        _cadete.MostrarInventario();
                        int itemIndice = LeerEnteroEnRango(" Selecciona el número del objeto a usar: ", 1, _cadete.Inventario.Count) - 1;
                        string item = _cadete.Inventario[itemIndice];
                        if (item.Contains("energía") || item.Contains("Células"))
                        {
                            _cadete.Energia = Math.Min(_cadete.Energia + 30, 100);
                            Console.WriteLine($"\n  Inyectaste {item}. Energía restaurada al {_cadete.Energia}%.");
                        }
                        else
                        {
                            _cadete.Salud = Math.Min(_cadete.Salud + 25, 100);
                            Console.WriteLine($"\n  Activaste {item}. Salud curada a {_cadete.Salud} HP.");
                        }
                        _cadete.Inventario.RemoveAt(itemIndice);
                    }
                }
                else // Intentar escapar
                {
                    if (_random.Next(1, 100) <= 50) 
                    {
                        Console.ForegroundColor = ConsoleColor.Yellow;
                        Console.WriteLine("\n  ¡Lograste escapar del combate a salvo!");
                        Console.ResetColor();
                        turnoEnemigoActivo = false;
                        enCombate = false;
                    }
                    else
                    {
                        Console.WriteLine("\n  ¡No pudiste escapar! El enemigo bloqueó tu retirada.");
                    }
                }
                Thread.Sleep(1500);
           
                if (enemigo.Salud <= 0)
                {
                    Console.ForegroundColor = ConsoleColor.Green;
                    Console.WriteLine($"\n  ¡El {enemigo.Nombre} ha sido debilitado!");
                    Console.WriteLine(" ¡Ganaste +50 puntos de XP y recolectaste una [Célula de energía]!");
                    _cadete.Experiencia += 50;
                    _cadete.Inventario.Add("Célula de energía");
                    Console.ResetColor();
                    enCombate = false;
                    turnoEnemigoActivo = false;
                    _mapa.ModificarCelda(_cadete.PosX, _cadete.PosY, '.'); 
                    Thread.Sleep(2000);
                }

                if (turnoEnemigoActivo && _cadete.Salud > 0)
                {
                    Console.WriteLine("\n -------------------------------------------------");
                    Console.WriteLine($"  Turno de {enemigo.Nombre}...");
                    Thread.Sleep(1000);
 
                    int dañoEnemigo = enemigo.EjecutarAtaqueEnemigo();
                    Console.ForegroundColor = ConsoleColor.Red;
                    Console.WriteLine($" ¡{_cadete.Nombre} recibió {dañoEnemigo} pts de daño!");
                    Console.ResetColor();
                    _cadete.Salud -= dañoEnemigo;
                    _cadete.Estabilidad -= 8; 
                    Thread.Sleep(2000);
                }
            }

            if (_cadete.Salud <= 0 || _cadete.Salud <= 0)
            {
                Console.ForegroundColor = ConsoleColor.DarkRed;
                Console.WriteLine("\n  Has caído en combate. Tus signos vitales se han extinguido...");
                Console.ResetColor();
                Thread.Sleep(2000);
            }
        }
        private void GatillarEventosCasilla(char elemento)
        {
            if (elemento == 'N')
            {
                Console.ForegroundColor = ConsoleColor.Green;
                Console.WriteLine("\n ANOMALÍA DETECTADA: ¡Ha localizado el núcleo energético perdido!");
                Console.WriteLine(" El objetivo principal ha sido asegurado. Secuencia de extracción autorizada.");
                _misionCompletada = true;
                _mapa.ModificarCelda(_cadete.PosX, _cadete.PosY, '.');
                Console.ResetColor();
                return;
            }
            int probabilidad = _random.Next(1, 100);
            if (probabilidad <= 25) 
            {
                Personaje rival;
                if (_random.Next(1, 3) == 1) rival = new centinela();
                else rival = new Enemigo();

                IniciarFaseCombatePokemon(rival);
            }
            else if (probabilidad > 25 && probabilidad <= 40)
            {
                string[] objetosPosibles = { "Células de energía", "Escudos", "Módulos de ataque" };
                string itemEncontrado = objetosPosibles[_random.Next(0, objetosPosibles.Length)];
                Console.ForegroundColor = ConsoleColor.Yellow;
                Console.WriteLine($"\n OBJETO ENCONTRADO: Recogiste [{itemEncontrado}] del suelo.");
                _cadete.Inventario.Add(itemEncontrado);
                Console.ResetColor();
                Thread.Sleep(1000);
            }
            else if (probabilidad > 40 && probabilidad <= 50)
            {
                Console.ForegroundColor = ConsoleColor.Red;
                Console.WriteLine("\n PÉRDIDA DE ENERGÍA: Radiación drena un -15% de tus sistemas.");
                _cadete.Energia -= 15;
                Console.ResetColor();
                Thread.Sleep(1000);
            }
        }
        private void MenuInventario()
        {
            Console.Clear();
            _cadete.MostrarInventario();
            if (_cadete.Inventario.Count == 0) return;
            Console.WriteLine("\n OPERACIONES: 1. Utilizar un Objeto | 2. Eliminar un Objeto | 3. Salir");
            int operacion = LeerEnteroEnRango("Seleccione opción: ", 1, 3);
            if (operacion == 3) return;
            int indice = LeerEnteroEnRango("Seleccione el NÚMERO del objeto con el que operar: ", 1, _cadete.Inventario.Count) - 1;
            string objeto = _cadete.Inventario[indice];
            if (operacion == 1)
            {
                SimularCarga($"Inyectando compuesto {objeto}");
                if (objeto.Contains("energía") || objeto.Contains("Células"))
                {
                    Console.WriteLine($"\n Usando célula. Energía: {_cadete.Energia} ➡ {Math.Min(_cadete.Energia + 25, 100)}");
                    _cadete.Energia += 25;
                }
                else if (objeto.Contains("Escudos") || objeto.Contains("Escudo"))
                {
                    Console.WriteLine($"\n Blindaje restaurado. Estabilidad: {_cadete.Estabilidad} ➡ {Math.Min(_cadete.Estabilidad + 30, 100)}");
                    _cadete.Estabilidad += 30;
                }
                else
                {
                    Console.WriteLine($"\n Has utilizado el modulo [{objeto}] aumentando temporalmente tus habilidades.");
                }
                _cadete.Inventario.RemoveAt(indice);
            }
            else if (operacion == 2)
            {
                _cadete.Inventario.RemoveAt(indice);
                Console.WriteLine($"\n Objeto [{objeto}] destruido y eliminado permanentemente del inventario.");
            }
        }
