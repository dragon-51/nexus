    public class MapaRealidad
    {
        public string Nombre { get; private set; }
        private char[,] _matriz;

        public MapaRealidad(string nombre, char[,] matriz)
        {
            Nombre = nombre;
            _matriz = matriz;
        }

        public int ObtenerFilas() => _matriz.GetLength(0);
        public int ObtenerColumnas() => _matriz.GetLength(1);
        public char ObtenerCelda(int x, int y) => _matriz[x, y];
        public void ModificarCelda(int x, int y, char valor) => _matriz[x, y] = valor;

        public void Renderizar(int jugadorX, int jugadorY)
        {
            Console.WriteLine($"\n========================================");
            Console.WriteLine($"   SISTEMA DE EXPLORACIÓN DE LA REALIDAD: {Nombre.ToUpper()}   ");
            Console.WriteLine("========================================");

            for (int i = 0; i < _matriz.GetLength(0); i++)
            {
                Console.Write("    ");
                for (int j = 0; j < _matriz.GetLength(1); j++)
                {
                    if (i == jugadorX && j == jugadorY)
                    {
                        Console.ForegroundColor = ConsoleColor.Yellow;
                        Console.Write("C ");
                        continue;
                    }

                    char celda = _matriz[i, j];
                    if (celda == '█') Console.ForegroundColor = ConsoleColor.DarkGray;
                    else if (celda == 'N') Console.ForegroundColor = ConsoleColor.Cyan;
                    else if (celda == '~') Console.ForegroundColor = ConsoleColor.Magenta;
                    else if (celda == 'R') Console.ForegroundColor = ConsoleColor.Yellow;
                    else if (celda == 'O') Console.ForegroundColor = ConsoleColor.Red;
                    else if (celda == '*') Console.ForegroundColor = ConsoleColor.DarkYellow;
                    else Console.ForegroundColor = ConsoleColor.Gray;

                    Console.Write(celda + " ");
                }
                Console.WriteLine();
            }
            Console.ResetColor();
            MostrarLeyenda();
            Console.WriteLine("========================================");
        }

        private void MostrarLeyenda()
        {
            Console.WriteLine("\n--- GLOSARIO DE LA MATRIZ ---");
            Console.WriteLine(" C -> Posición Actual del Cadete");
            Console.WriteLine(" █ -> Obstáculo Dimensional No Transitable");
            Console.WriteLine(" . -> Sector del Espacio Abierto Transitable");
            Console.WriteLine(" N -> Núcleo Energético de la Anomalía");
        }
    }

 
    public class SistemaNexus
    {
        private Cadete _cadete;
        private MapaRealidad _mapa;
        private bool _sesionActiva = true;
        private bool _misionCompletada = false;
        private Random _random = new Random();

        public static event InterferenciaIrisHandler OnAnomaliaIris;

        public SistemaNexus()
        {
            OnAnomaliaIris += MostrarAlertaIris;
        }

        public void Ejecutar()
        {
            Console.WriteLine("========================================");
            Console.WriteLine("    BIENVENIDO AL SISTEMA NEXUS v2.0   ");
            Console.WriteLine("========================================");

            string nombre = LeerCadenaObligatoria("Ingrese Identificación del Cadete: ");
            int edad = LeerEnteroEnRango("Ingrese Edad del Cadete: ", 16, 100);

            _mapa = SeleccionarMatrizRealidad();

            Console.Clear();
            int energia = LeerEnteroEnRango("Ingrese Energía Inicial (0-100): ", 0, 100);
            int estabilidad = LeerEnteroEnRango("Ingrese Estabilidad Inicial (0-100): ", 0, 100);

            _cadete = new Cadete(nombre, edad, energia, estabilidad);

            if (_cadete.Energia < 50 || _cadete.Estabilidad < 20)
            {
                Console.ForegroundColor = ConsoleColor.Red;
                Console.WriteLine("\n[ACCESO RECHAZADO]: Constantes biométricas deficientes.");
                Console.ResetColor();
                return;
            }

            ProcesarConexionIris();
            BucleJuegoPrincipal();
        }

        private void ProcesarConexionIris()
        {
            string servidor = "192.168.40.11";
            int puerto = 5000;
            try
            {
                Console.WriteLine($"[RED]: Conectando al servidor central NEXUS en {servidor}:{puerto}...");
                using (TcpClient cliente = new TcpClient(servidor, puerto))
                using (NetworkStream stream = cliente.GetStream())
                {
                    string mensajeInicio = $"Cadete {_cadete.Nombre} ha iniciado sesión en Realidad: {_mapa.Nombre}";
                    byte[] datosEnvio = Encoding.UTF8.GetBytes(mensajeInicio);
                    stream.Write(datosEnvio, 0, datosEnvio.Length);
                }
            }
            catch (Exception ex)
            {
                Console.ForegroundColor = ConsoleColor.Yellow;
                Console.WriteLine($"[ADVERTENCIA DE RED]: Servidor externo inalcanzable ({ex.Message}).");
                Console.WriteLine("[RED]: El modo simulación local continuará de manera autónoma.");
                Console.ResetColor();
            }
        }

        private void BucleJuegoPrincipal()
        {
            while (_sesionActiva)
            {
                double entropia = (100 - _cadete.Estabilidad) * (100 - _cadete.Energia);


if (entropia > 5600 || _cadete.Salud <= 0)
                {
                    OnAnomaliaIris?.Invoke("CRÍTICO: Colapso del nexo simbiótico o muerte biológica.", entropia);
                    Console.WriteLine("\n[NEXUS]: Desconexión forzada de emergencia ejecutada.");
                    break;
                }
                ImprimirPanelEstadisticas(entropia);
                int opcion = LeerEnteroEnRango("Seleccione Operación (1-5): ", 1, 5);
                ProcesarAccionMenu(opcion);
                if (_sesionActiva && opcion != 1)
                {
                    Console.WriteLine("\nPresione cualquier tecla para continuar...");
                    Console.ReadKey(true);
                    Console.Clear();
                }
            }
        }
        private void ImprimirPanelEstadisticas(double entropia)
        {
            Console.Clear();
            Console.WriteLine("========================================");
            Console.WriteLine("         NEXUS TRAINING SYSTEM          ");
            Console.WriteLine("========================================");
            Console.WriteLine($"CADETE: {_cadete.Nombre.ToUpper()} | INTEGRIDAD BIOLÓGICA: {_cadete.Salud}%");
            Console.WriteLine($"REALIDAD: {_mapa.Nombre.ToUpper()} | XP: {_cadete.Experiencia} pts");
            Console.WriteLine($"ENERGÍA: {_cadete.Energia}% | ESTABILIDAD: {_cadete.Estabilidad}% | ENTROPÍA: {entropia}");
            if (_misionCompletada) Console.WriteLine("OBJETIVO: [ ANOMALÍA EXTRAÍDA - DIRÍJASE A LA SALIDA]");
            else Console.WriteLine("OBJETIVO: [ LOCALICE EL NÚCLEO ENERGÍTICO 'N' EN EL MAPA]");
            Console.WriteLine("----------------------------------------");
            Console.WriteLine("1. Desplazamiento Terrestre (Explorar Zonas de Forma Continua)");
            Console.WriteLine("2. Gestionar Inventario (Usar / Consultar)");
            Console.WriteLine("3. Escanear Flujos de Red");
            Console.WriteLine("4. Sobrecargar Células de Poder");
            Console.WriteLine("5. Intentar Extracción Segura (Salir)");
            Console.WriteLine("========================================");
            DibujarBarra("Energía", _cadete.Energia, ConsoleColor.Blue);
            DibujarBarra("Estabilidad", _cadete.Estabilidad, ConsoleColor.Green);
